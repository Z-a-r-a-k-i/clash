[gd_resource type="Resource" script_class="ScenarioDef" format=3 uid="uid://cqp60ix7icpmm"]

[ext_resource type="Script" uid="uid://52bndl3xhdrr" path="res://scripts/data/scenario_def.gd" id="1_scendef"]
[ext_resource type="Script" uid="uid://dlxuhy3agr5d2" path="res://scripts/data/scenario_placement.gd" id="2_place"]

; Player 0: 1 base + 4 workers + 4 mineral patches + 1 geyser. Player 1:
; 1 base far across the map (so the win check doesn't fire). Drives the
; gather pipeline at scale once a renderer + UI exist (plan-07b).
;
; mineral_patch footprint is Vector2i(1, 3) — patches are arranged in a
; 2x2 cluster at x=5,6 / y=14,17 (each patch spans 3 rows vertically).
; base footprint is 4x4 (placed at origin (5,5) → occupies (5,5)..(8,8)).
; Workers at (5..8, 10) avoid the base. Geyser is 3x3 placed clear of
; everything else.
; Mineral patches and the geyser use owner_player_id = -1 (neutral) so
; the resolver's owner-filtered logic (target validity, deposit-sink
; lookups, etc.) treats them correctly.

[sub_resource type="Resource" id="Resource_b0"]
script = ExtResource("2_place")
def_id = "base"
owner_player_id = 0
origin = Vector2i(5, 5)

[sub_resource type="Resource" id="Resource_w0"]
script = ExtResource("2_place")
def_id = "worker"
owner_player_id = 0
origin = Vector2i(5, 10)

[sub_resource type="Resource" id="Resource_w1"]
script = ExtResource("2_place")
def_id = "worker"
owner_player_id = 0
origin = Vector2i(6, 10)

