# Godot
.godot/
.import/
*.tmp
# Stray test scratch files Godot's "Run" command sometimes drops at
# project roots. Anchored to repo root and client/ specifically so
# legitimate tests under nested paths (e.g. client/scripts/_dev/test_*.gd)
# are NOT ignored. See docs/GODOT-NOTES.md "Cleaning up test artifacts".
/.test_*
/test_*.tscn
/test_*.tres
/test_*.gd
client/.test_*
client/test_*.tscn
client/test_*.tres
client/test_*.gd

# Godot exports / builds
build/
exports/

# C# / .NET
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/

# Go
*.exe
*.test
*.out
vendor/

# Editors
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Local environment
.env
.env.local

# Logs
*.log

# Claude Code: keep settings.json shared, ignore local overrides
.claude/settings.local.json
.claude/scheduled_tasks.lock

# godot-ai-plugin (used externally per ADR 0008; junction installed locally)
client/addons/godot_ai/
.superpowers/
